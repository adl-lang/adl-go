{{/*
Shared: dispatch entry, file header/imports, custom-type construction

One define per xxxParams type; templates/render dispatches to them
by Go type name via gotmpl's tmpl_by_type.
*/}}

{{/* ---------- dispatch ---------- */}}

{{define "render"}}{{- tmpl_by_type . "" "" -}}
{{end}}

{{/* ---------- file scaffolding ---------- */}}

{{define "headerParams"}}// Code generated by goadlc - DO NOT EDIT.
package {{.Pkg}}

{{end}}

{{define "importsParams"}}import ({{range .Imports}}
	{{if .Aliased}}{{.Name}} {{end}}"{{.Path}}"{{end}}
)
{{end}}

{{/* ---------- custom types ---------- */}}

{{define "custTypeConstructionParams"}}{{- $G := .G -}}
{{.G.GoImport "adljson"}}Unwrap(((*{{.CustomTypeHelper}})(nil)).Construct(
		&{{.CustomType}}{{.TypeParams.RSide}}{},
		{{.AnyValue}},
		{{range .TypeExprStrs}}{{$G.GoImport "adl"}}CreateUncheckedJsonDecodeBinding(
			{{.}},
			{{$G.GoImport "adl"}}RESOLVER,
		).Binder(),
		{{end}}
	)).({{.CustomType}}{{.TypeParams.RSide}}){{end}}

{{/* ---------- type expressions ---------- */}}

{{define "texprParams"}}adlast.Make_TypeExpr({{tmpl_by_type .Te.TypeRef.Branch "texpr" ""}} , []adlast.TypeExpr{{"{"}}{{range $i, $p := .Params}}{{if $i}},{{end}}{{template "texprParams" $p}}{{end}}{{"}"}}){{end}}

{{define "texpr_TypeRef_Primitive"}}adlast.Make_TypeRef_primitive("{{.V}}"){{end}}

{{define "texpr_TypeRef_Reference"}}adlast.Make_TypeRef_reference(adlast.Make_ScopedName("{{.V.ModuleName}}", "{{.V.Name}}")){{end}}

{{define "texpr_TypeRef_TypeParam"}}{{panic "typeParm not valid in mono te"}}{{end}}

{{/* ---------- primitive values ---------- */}}

{{define "primParams"}}{{$n := .Tmpl}}{{template $n .}}{{end}}

{{define "prim_number"}}{{.Val}}{{end}}

{{define "prim_String"}}{{.JSON}}{{end}}

{{define "prim_Void"}}struct{}{}{{end}}

{{define "prim_Json"}}{{if .IsNil}}nil{{else}}{{.GoSyntax}}{{end}}{{end}}

{{define "prim_TypeToken"}}{{.AdlastPkg}}Make_ATypeExpr[{{.ElemGoType}}]({{.ElemTexpr}}){{end}}

{{define "prim_Nullable"}}{{if .IsNil}}nil{{else}}{{.AdlPkg}}Addr({{.ElemValue}}){{end}}{{end}}

{{define "prim_Vector"}}{{$e := .ElemGoType}}{{$vs := .Elems}}{{if not $vs}}[]{{$e}}{}{{else}}[]{{$e}}{
{{range $vs}}{{.}},
{{end}}}{{end}}{{end}}

{{define "prim_StringMap"}}{{$e := .ElemGoType}}{{$es := .Entries}}{{if not $es}}map[string]{{$e}}{}{{else}}map[string]{{$e}}{
{{range $es}}"{{.K}}" : {{.V}},
{{end}}}{{end}}{{end}}

{{/* ---------- generated-constructor calls ---------- */}}

{{define "ctorParams"}}{{.Ctor}}({{if .Args}}
{{range .Args}}{{.}},
{{end}}{{end}}){{end}}

{{define "annEntryParams"}}adlast.Make_ScopedName("{{.ModuleName}}", "{{.Name}}"): {{if .IsNil}}nil{{else}}{{.GoSyntax}}{{end}}{{end}}

{{define "annMapParams"}}customtypes.MapMap[adlast.ScopedName, any]{{"{"}}{{range $i, $e := .Entries}}{{if $i}},{{end}}{{$e}}{{end}}{{"}"}}{{end}}
