{{/*
goadlc gotypes: Go decls generated from an ADL module

One define per xxxParams type; templates/render dispatches to them
by Go type name via gotmpl's tmpl_by_type.
*/}}

{{/* ---------- file bodies ---------- */}}

{{define "gotypes_decls_body"}}{{range .Decls}}{{template "declParams" .}}{{end}}{{end}}

{{define "gotypes_ast_body"}}{{range .Decls}}{{with .Texpr}}{{template "aTexprParams" .}}{{end}}{{template "scopedDeclParams" .Reg}}{{end}}{{end}}

{{/* ---------- decls ---------- */}}

{{define "declParams"}}{{$P := .}}{{tmpl_by_type .Decl.Type_.Branch.V "decl_" ""}}{{end}}

{{define "decl_Struct"}}{{$decl := $P}}
{{$name := $decl.Name | public}}
{{$G := $decl.G}}
type {{$name}}{{$decl.TypeParams.LSide}} struct {
	_{{$name}}{{$decl.TypeParams.RSide}}
}

type _{{$name}}{{$decl.TypeParams.LSide}} struct {
{{range $decl.Fields}}	{{.Name|public}} {{$G.GoType .TypeExpr .Annotations}} `json:"{{.SerializedName}}"`
{{end -}}
}

func MakeAll_{{$name}}{{$decl.TypeParams.LSide}}(
{{range $decl.Fields}}{{if not .IsVoid}}	{{.Name | lower | $G.GoEscape}} {{$G.GoType .TypeExpr .Annotations}},
{{end}}{{end -}}
) {{$name}}{{$decl.TypeParams.RSide}} {
	return {{$name}}{{$decl.TypeParams.RSide}}{
		_{{$name}}{{$decl.TypeParams.RSide}}{
{{range $decl.Fields}}
{{- if .IsVoid -}}
{{$type := $G.GoType .TypeExpr .Annotations}}			{{.Name | public}}: struct{}{},
{{- else -}}
{{$type := $G.GoType .TypeExpr .Annotations}}			{{.Name | public}}: {{.Name | lower | $G.GoEscape}},
{{- end}}
{{end}}	},
		}
}

{{if $decl.ContainsTypeToken}}
// struct {{$name}} contains at least one TypeToken, not generating Make_ funcs
{{else}}
func Make_{{$name}}{{$decl.TypeParams.LSide}}(
{{range $decl.Fields}}{{if not .IsVoid}}{{if not .HasDefault}}	{{.Name | lower | $G.GoEscape}} {{$G.GoType .TypeExpr .Annotations}},
{{end}}{{end}}{{end -}}
) {{$name}}{{$decl.TypeParams.RSide}} {
	ret := {{$name}}{{$decl.TypeParams.RSide}}{
		_{{$name}}{{$decl.TypeParams.RSide}}{
{{range $decl.Fields}}{{$type := $G.GoType .TypeExpr .Annotations}} {{if not .IsVoid}} {{if not .HasDefault}}		{{.Name | public}}: {{.Name | lower | $G.GoEscape}},
{{else}}		{{.Name | public}}: ((*{{$name}}{{$decl.TypeParams.RSide}})(nil)).Default_{{.Name}}(),
{{end}}
{{- else -}}
		{{.Name | public}}: struct{}{},
{{end}}
{{- end}}	},
		}
	return ret
}

{{range $decl.Fields}}{{$type := $G.GoType .TypeExpr .Annotations}}{{if .HasDefault}}func (*{{$decl.Name}}{{$decl.TypeParams.RSide}}) Default_{{.Name | $G.GoEscape}}() {{$type}} {
	return {{$G.GoValue .Annotations .TypeExpr .Just}}
}
{{end}}{{end}}
{{end}}
{{end}}

{{define "decl_Union"}}{{$decl := $P}}{{$G := $decl.G}}
{{$name := $decl.Name | $G.GoEscape | public}}
type {{$name}}{{$decl.TypeParams.LSide}} struct {
	Branch {{$name}}Branch{{$decl.TypeParams.RSide}}
}

type {{$name}}Branch{{$decl.TypeParams.LSide}} interface {
	is{{$name}}Branch()
}

func (*{{$name}}{{$decl.TypeParams.RSide}}) MakeNewBranch(key string) (any, error) {
	switch key {
	{{range $decl.Branches -}}{{$type := $G.GoType .TypeExpr .Annotations}}case "{{.SerializedName}}":
		return &_{{$name}}_{{.Name | public}}{{$type.UnionTypeParams.RSide}}{}, nil
	{{end}}}
	return nil, {{$G.GoImport "fmt"}}Errorf("unknown branch is : %s", key)
}

{{range $decl.Branches -}}{{$type := $G.GoType .TypeExpr .Annotations}}
type _{{$name}}_{{.Name | public}}{{$type.UnionTypeParams.LSide}} struct {
	V {{$type}} `branch:"{{.Name}}"`
}{{end}}

{{range $decl.Branches -}}{{$Type := $G.GoType .TypeExpr .Annotations}}
func (_{{$name}}_{{.Name | public}}{{$Type.UnionTypeParams.RSide}}) is{{$name}}Branch() {}
{{- end}}

{{range $decl.Branches -}}{{$Type := $G.GoType .TypeExpr .Annotations}}
{{if .IsVoid -}}
func Make_{{$name}}_{{.Name}}{{$decl.TypeParams.LSide}}() {{$name}}{{$decl.TypeParams.RSide}} {
	return {{$name}}{{$decl.TypeParams.RSide}}{
		_{{$name}}_{{.Name | public}}{{$Type.UnionTypeParams.RSide}}{struct{}{}},
	}
}
{{- else -}}
func Make_{{$name}}_{{.Name}}{{$decl.TypeParams.LSide}}(v {{$Type}}) {{$name}}{{$decl.TypeParams.RSide}} {
	return {{$name}}{{$decl.TypeParams.RSide}}{
		_{{$name}}_{{.Name | public}}{{$Type.UnionTypeParams.RSide}}{v},
	}
}
{{- end}}
{{end}}

{{range $decl.Branches -}}{{$Type := $G.GoType .TypeExpr .Annotations}}
func (un {{$name}}{{$decl.TypeParams.RSide}})Cast_{{.Name}}() ({{$Type}}, bool) {
	br, ok := un.Branch.(_{{$name}}_{{.Name | public}}{{$Type.UnionTypeParams.RSide}})
	return br.V, ok
}
{{end}}

{{$htp := $decl.TypeParams.AddParam "T"}}

func Handle_{{$name}}{{$htp.LSide}}(
	_in {{$name}}{{$decl.TypeParams.RSide}},{{range $decl.Branches}}{{$Type := $G.GoType .TypeExpr .Annotations}}
	{{.Name}} func({{.Name}} {{$Type}}) ({{$htp.Last}}),{{end}}
	_default func() {{$htp.Last}},
) ({{$htp.Last}}) {
	switch _b := _in.Branch.(type) {
	{{range $decl.Branches -}}{{- $Type := $G.GoType .TypeExpr .Annotations -}}
	case _{{$name}}_{{.Name | public}}{{$Type.UnionTypeParams.RSide}}:
		if {{.Name}} != nil {
			return {{.Name}}(_b.V)
		}
	{{end}}}
	if _default != nil {
		return _default()
	}
	panic("unhandled branch in : {{$name}}")
}

func HandleWithErr_{{$name}}{{$htp.LSide}}(
	_in {{$name}}{{$decl.TypeParams.RSide}},{{range $decl.Branches}}{{$Type := $G.GoType .TypeExpr .Annotations}}
	{{.Name}} func({{.Name}} {{$Type}}) ({{$htp.Last}}, error),{{end}}
	_default func() ({{$htp.Last}}, error),
) ({{$htp.Last}}, error) {
	switch _b := _in.Branch.(type) {
	{{range $decl.Branches -}}{{$Type := $G.GoType .TypeExpr .Annotations -}}
	case _{{$name}}_{{.Name | public}}{{$Type.UnionTypeParams.RSide}}:
		if {{.Name}} != nil {
			return {{.Name}}(_b.V)
		}
	{{end}}}
	if _default != nil {
		return _default()
	}
	panic("unhandled branch in : {{$name}}")
}
{{end}}

{{define "decl_TypeDef"}}{{$G := $P.G}}
type {{$P.Name|public}}{{$P.TypeParams.LSide}} = {{$G.GoType .TypeExpr $P.Annotations}}
{{end}}

{{define "decl_NewType"}}{{$G := $P.G}}
type {{$P.Name|public}}{{$P.TypeParams.LSide}} {{$G.GoType .TypeExpr $P.Annotations}}
{{end}}

{{/* ---------- ast registration ---------- */}}

{{define "aTexprParams"}}{{$G := .G}}
func Texpr_{{.Name}}{{.TypeParams.LSide}}({{.TypeParams.TexprArgs}}) {{$G.GoImport "adlast"}}ATypeExpr[{{.TypeName}}{{.TypeParams.RSide}}] {
	te := {{$G.GoImport "adlast"}}Make_TypeExpr(
		{{$G.GoImport "adlast"}}Make_TypeRef_reference(
			{{$G.GoImport "adlast"}}Make_ScopedName("{{.ModuleName}}", "{{.Name}}"),
		),
		[]{{$G.GoImport "adlast"}}TypeExpr{ {{- .TypeParams.TexprValues -}} },
	)
	return {{$G.GoImport "adlast"}}Make_ATypeExpr[{{.TypeName}}{{.TypeParams.RSide}}] (te)
}
{{end}}

{{define "scopedDeclParams"}}{{$G := .G}}
{{$name := .Name | .G.GoEscape | public}}
func AST_{{$name}}() {{$G.GoImport "adlast"}}ScopedDecl {
	decl := {{$G.GoDeclValue .Decl}}
	return {{$G.GoImport "adlast"}}Make_ScopedDecl("{{.ModuleName}}", decl)
}

func init() {
	{{$G.GoImport "adl"}}RESOLVER.Register(
		{{$G.GoImport "adlast"}}Make_ScopedName("{{.ModuleName}}", "{{.Name}}"),
		AST_{{.Name}}(),
	)
	{{template "registerHelper" .}}}
{{end}}

{{/*
The custom-type helper registration of one decl, or nothing when the decl
carries no go_custom_type annotation. Calling RegisterHelperName is what
registers the helper package's import, so it runs even for the stdlib form
that needs no qualifier.
*/}}
{{define "registerHelper"}}{{$G := .G}}{{$helper := $G.RegisterHelperName .Decl}}{{if $helper}}	{{if not $G.IsStdLibGen}}adl.{{end}}RESOLVER.RegisterHelper(
			adlast.Make_ScopedName("{{.ModuleName}}", "{{.Name}}"),
			(*{{$helper}})(nil),
		)
{{end}}{{end}}
